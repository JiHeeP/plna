# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Supabase migration only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kimi 2.5 (AI 인사이트)
KIMI_API_KEY=YOUR_KIMI_API_KEY
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0711-preview

# X Likes Digest
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret
# Optional (preferred for v2 endpoints if available)
X_BEARER_TOKEN=your_x_bearer_token
X_USER_ID=your_x_user_id
DIGEST_TIMEZONE=Asia/Seoul

# 홈 화면 위젯 (/api/widget, /api/widget/image)
# 위젯 URL은 폰에 그대로 저장되므로 앱 비밀번호가 아닌 전용 랜덤 토큰을 쓴다.
# 생성 예: openssl rand -hex 24
PLNA_WIDGET_TOKEN=YOUR_WIDGET_TOKEN
# 위젯 응답 캐시 TTL(초). Firestore 읽기 쿼터를 아끼기 위한 값. 기본 300, 0이면 캐시 없음.
PLNA_WIDGET_CACHE_SECONDS=300
# 위젯이 '오늘'을 판단할 타임존. 미설정 시 DIGEST_TIMEZONE, 그다음 Asia/Seoul.
PLNA_WIDGET_TIMEZONE=Asia/Seoul
